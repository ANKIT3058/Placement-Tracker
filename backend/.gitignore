node_modules
# Keep environment variables out of version control.
# .env.example is deliberately NOT ignored — it is the template, and carries
# placeholders only.
.env

# Compiled Prisma CLI config. The CLI loads prisma.config.ts directly, so these
# emitted files are redundant; they are ignored because a committed copy is how
# a datasource credential previously reached version control.
prisma.config.js
prisma.config.js.map
prisma.config.d.ts
prisma.config.d.ts.map

/generated/prisma

# Downloaded email attachments (local storage backend)
/storage

# Database dumps written by the migration verification framework
# (scripts/migration). These contain real data and must never be committed.
/backups

# Reports written by the one-off Event identity cleanup
# (scripts/cleanup). These carry real Event identity data and Event 54's
# exported change history, which exists nowhere else once that row is deleted.
# Keep them; never commit them.
/scripts/cleanup/artifacts
