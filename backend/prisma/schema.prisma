// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The root aggregate of the domain (RFC-001 §6.2 P1). Introduced by AC-5.1 as a
// standalone table: nothing references it yet, and it references nothing.
//
// Identity is keyed on `googleSub` — the opaque, immutable Google subject — and
// never on `email`, which is mutable, reassignable by a Workspace administrator,
// and therefore unsafe as an authentication key (RFC-001 §8.1). `email` carries
// no unique constraint for the same reason; it is a display and contact
// attribute, indexed only for lookup.
//
// The back-relations to GmailAccount, Email, Event and EventUpdate specified in
// RFC-001 §12.1 are deliberately absent here. Prisma requires the opposite side
// of a relation to exist, and that side is the nullable `userId` column on each
// child — which belongs to AC-5.2. Declaring them now would force those columns
// into this migration. They are added in AC-5.2 alongside the columns that make
// them representable.
model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  googleSub     String  @unique
  email         String
  emailVerified Boolean @default(false)
  name          String?
  imageUrl      String?

  status      String    @default("active") // active | disabled | deleted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  deletedAt   DateTime?

  @@index([email])
}

model Event {
  id Int @id @default(autoincrement())

  company String
  stage   String
  date    DateTime
  time    String?
  venue   String?

  eventKey String @unique

  confidence   Float   @default(0)
  status       String  @default("scheduled")
  reviewReason String?

  isTimeEstimated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates EventUpdate[]
}

model EventUpdate {
  id Int @id @default(autoincrement())

  eventId  Int
  field    String
  oldValue String
  newValue String

  updatedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Email {
  id             Int     @id @default(autoincrement())
  gmailMessageId String? @unique

  // The Gmail account that synced this email. Optional so pre-existing rows
  // (synced before accounts were tracked) remain valid; every newly synced
  // email always stores its originating account.
  gmailAccountId Int?

  subject String
  body    String
  sender  String

  receivedAt DateTime @default(now())

  processingStatus String  @default("pending")
  failureReason    String?

  createdAt DateTime @default(now())

  gmailAccount GmailAccount?     @relation(fields: [gmailAccountId], references: [id])
  extractions  EmailExtraction[]
  attachments  Attachment[]

  @@index([gmailAccountId])
}

model Attachment {
  id                Int     @id @default(autoincrement())
  emailId           Int
  gmailAttachmentId String
  filename          String
  mimeType          String
  size              Int?

  storagePath String?

  // Full processing lifecycle (download + future parsing/extraction), not just
  // download: pending -> processing -> completed | failed.
  processingStatus String    @default("pending")
  processingError  String?
  processedAt      DateTime?

  // Parsed document results, populated by DocumentProcessingService when a
  // parser handles this attachment's MIME type. Independent of download status:
  // a parse failure records `parsingError` but leaves the attachment completed.
  text           String? // normalized extracted text
  parsedData     Json? // structured parser output (e.g. future Excel rows)
  parsedMetadata Json? // parser-specific metadata (e.g. PDF page count)
  parsedAt       DateTime? // successful parse time
  parsingError   String? // parse failure reason (download still succeeded)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailExtraction {
  id Int @id @default(autoincrement())

  emailId Int

  company String?
  stage   String?
  date    DateTime?
  time    String?
  venue   String?

  isTimeEstimated Boolean?
  status          String?

  confidence Float

  rawText String?

  createdAt DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model GmailAccount {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  refreshToken String
  historyId    String?
  connectedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  emails Email[]
}
