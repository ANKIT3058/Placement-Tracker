// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// No connection URL here, and none is possible: Prisma 7 removed both `url` and
// `directUrl` from the schema file (P1012 — "no longer supported in schema
// files"). Connection configuration moved out of the schema entirely:
//
//   Prisma Migrate / db  →  `datasource.url` in prisma.config.ts
//                           (DIRECT_DATABASE_URL — unpooled)
//   Prisma Client        →  the adapter passed to the PrismaClient constructor
//                           in src/lib/prisma.ts (DATABASE_URL — pooled)
//
// The pooled/direct split therefore lives in those two files, not here.
datasource db {
  provider = "postgresql"
}

// The root aggregate of the domain (RFC-001 §6.2 P1).
//
// Identity is keyed on `googleSub` — the opaque, immutable Google subject — and
// never on `email`, which is mutable, reassignable by a Workspace administrator,
// and therefore unsafe as an authentication key (RFC-001 §8.1). `email` carries
// no unique constraint for the same reason; it is a display and contact
// attribute, indexed only for lookup.
//
// The back-relations below are the opposite side of the `userId` column on each
// child. As of AC-5.9 ownership is mandatory: every `userId` is NOT NULL, and
// each child that has a tenant-scoped parent reaches this row through a
// composite foreign key on (parentId, userId), so a record cannot disagree with
// its parent's owner (RFC-001 §12.3).
model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  googleSub     String  @unique
  email         String
  emailVerified Boolean @default(false)
  name          String?
  imageUrl      String?

  status      String    @default("active") // active | disabled | deleted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  deletedAt   DateTime?

  gmailAccounts GmailAccount[]
  emails        Email[]
  events        Event[]
  eventUpdates  EventUpdate[]

  @@index([email])
}

model Event {
  id Int @id @default(autoincrement())

  userId Int

  company String
  stage   String
  date    DateTime
  time    String?
  venue   String?

  // Unique per owner, not globally. Two students receiving the same placement
  // broadcast produce the same key and must still hold two distinct Events
  // (RFC-001 §7.4).
  eventKey String

  confidence   Float   @default(0)
  status       String  @default("scheduled")
  reviewReason String?

  isTimeEstimated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  updates EventUpdate[]

  @@unique([userId, eventKey])
  @@unique([id, userId])
  @@index([userId, date])
  @@index([userId, status])
}

model EventUpdate {
  id Int @id @default(autoincrement())

  userId Int

  eventId  Int
  field    String
  oldValue String
  newValue String

  updatedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  // Composite: an EventUpdate whose owner differs from its Event's owner is now
  // unrepresentable rather than merely incorrect.
  event Event @relation(fields: [eventId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, eventId])
}

model Email {
  id             Int     @id @default(autoincrement())
  gmailMessageId String? @unique

  userId Int

  // The Gmail account that synced this email. Optional so pre-existing rows
  // (synced before accounts were tracked) remain valid; every newly synced
  // email always stores its originating account.
  gmailAccountId Int?

  subject String
  body    String
  sender  String

  receivedAt DateTime @default(now())

  processingStatus String  @default("pending")
  failureReason    String?

  createdAt DateTime @default(now())

  user         User              @relation(fields: [userId], references: [id])
  // Composite where the mailbox is known. `gmailAccountId` stays nullable —
  // emails accepted through the manual ingestion route have no mailbox — and a
  // NULL there simply leaves the constraint unchecked for that row.
  gmailAccount GmailAccount?     @relation(fields: [gmailAccountId, userId], references: [id, userId])
  // Singular and optional, not a list. An email yields exactly one extraction,
  // enforced by `@@unique([emailId, userId])` on the other side — see the note
  // there for why. Prisma derives cardinality from that constraint, so this
  // field cannot remain `EmailExtraction[]` once it exists.
  extraction   EmailExtraction?
  attachments  Attachment[]

  @@unique([id, userId])
  @@index([gmailAccountId])
  @@index([userId, receivedAt])
  @@index([userId, processingStatus])
}

model Attachment {
  id      Int @id @default(autoincrement())
  emailId Int

  // Tenant key, carried as a plain column with no relation to User. Enforcement
  // for derivative records runs through the parent: AC-5.10 attaches the
  // composite foreign key to Email(id, userId) (RFC-001 §7.2, §12.3), which is
  // what makes tenant divergence from the owning Email unrepresentable. A direct
  // User relation would add a second, weaker path to the same fact — which is
  // why RFC-001 §12.1 lists no back-relation for this model.
  userId Int

  gmailAttachmentId String
  filename          String
  mimeType          String
  size              Int?

  storagePath String?

  // Full processing lifecycle (download + future parsing/extraction), not just
  // download: pending -> processing -> completed | failed.
  processingStatus String    @default("pending")
  processingError  String?
  processedAt      DateTime?

  // Parsed document results, populated by DocumentProcessingService when a
  // parser handles this attachment's MIME type. Independent of download status:
  // a parse failure records `parsingError` but leaves the attachment completed.
  text           String? // normalized extracted text
  parsedData     Json? // structured parser output (e.g. future Excel rows)
  parsedMetadata Json? // parser-specific metadata (e.g. PDF page count)
  parsedAt       DateTime? // successful parse time
  parsingError   String? // parse failure reason (download still succeeded)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email Email @relation(fields: [emailId, userId], references: [id, userId], onDelete: Cascade)

  @@index([emailId])
}

model EmailExtraction {
  id Int @id @default(autoincrement())

  emailId Int

  // See Attachment.userId — same pattern, same reason.
  userId Int

  company String?
  stage   String?
  date    DateTime?
  time    String?
  venue   String?

  isTimeEstimated Boolean?
  status          String?

  confidence Float

  rawText String?

  createdAt DateTime @default(now())

  email Email @relation(fields: [emailId, userId], references: [id, userId], onDelete: Cascade)

  // One extraction per email, enforced by the DATABASE rather than by the
  // repository (PR-9G).
  //
  // Every crash point in the email-processing path converges on the same
  // symptom: `createExtraction` ran, the job died before BullMQ acknowledged it,
  // the stalled checker replayed the job, and the insert ran a second time. A
  // deterministic BullMQ jobId prevents a duplicate *job*; it says nothing about
  // side effects a job already committed, because Redis cannot know what
  // Postgres did.
  //
  // Application-side guards do not close this. A `findFirst` before `create` is
  // two statements with a window between them, and it would appear to work only
  // for as long as concurrency stays at 1 — which is a scheduling accident, not
  // an invariant. The constraint holds regardless of worker count, host
  // restarts, or stalled-job overlap.
  //
  // Composite with `userId` rather than keyed on `emailId` alone: `emailId` is
  // unique only within an owner, and the relation itself is composite
  // (RFC-001 §12.3). Keyed on the email alone, one tenant's replay could address
  // another tenant's row.
  @@unique([emailId, userId])
}

// The mailbox provider this connection represents (RFC-001 §12.2). A
// discriminator, not an abstraction: there is no strategy interface and no
// dispatch keyed on it. It exists so the provider is data rather than only the
// table's name — integration code can assert `provider == GOOGLE` instead of
// assuming it, and a second provider would not require renaming a table that
// carries foreign keys from Email, EmailExtraction and Attachment.
//
// `@default(GOOGLE)` exists so this expand migration needs no backfill; it
// should be dropped if a second variant is ever added, so new rows must state
// their provider explicitly.
enum MailProvider {
  GOOGLE
}

model GmailAccount {
  id     Int @id @default(autoincrement())
  userId Int

  provider MailProvider @default(GOOGLE)

  email        String   @unique
  refreshToken String
  historyId    String?
  connectedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  // When Google last refused this mailbox's refresh token as permanently
  // invalid — HTTP 400 `invalid_grant`, which Google documents as requiring the
  // user to authenticate and consent again. Presenting the same token cannot
  // succeed, so the background scheduler skips the mailbox until a reconnect
  // clears this; an explicit user-triggered sync may still attempt it.
  //
  // Nullable rather than a status enum: existing rows need no backfill, and the
  // timestamp records WHEN authentication broke, which a boolean would lose.
  // NULL means the mailbox is eligible for automatic sync.
  reauthRequiredAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  // Composite-FK anchor. Exists so children can reference (id, userId) together
  // and therefore cannot disagree with this row's owner (RFC-001 §12.3).
  @@unique([id, userId])
  @@index([userId])
}
