// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id        Int           @id @default(autoincrement())
  company   String
  stage     String
  date      DateTime
  time      String?
  venue     String?
  eventKey  String        @unique
  createdAt DateTime      @default(now())
  updates   EventUpdate[]
}

model EventUpdate {
  id        Int      @id @default(autoincrement())
  eventId   Int
  field     String
  oldValue  String
  newValue  String
  updatedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
}

model EmailExtraction {
  id        Int      @id @default(autoincrement())

  company   String?
  stage     String?
  date      DateTime?
  time      String?
  venue     String?

  isTimeEstimated Boolean @default(false)

  confidence Float?
  status     String?

  rawText    String

  createdAt  DateTime @default(now())
}
