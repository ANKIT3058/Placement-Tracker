// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The root aggregate of the domain (RFC-001 §6.2 P1).
//
// Identity is keyed on `googleSub` — the opaque, immutable Google subject — and
// never on `email`, which is mutable, reassignable by a Workspace administrator,
// and therefore unsafe as an authentication key (RFC-001 §8.1). `email` carries
// no unique constraint for the same reason; it is a display and contact
// attribute, indexed only for lookup.
//
// AC-5.2 adds the back-relations below. They are the opposite side of the
// nullable `userId` columns on each child. Ownership is not yet enforced: every
// `userId` is optional and every existing row has NULL. AC-5.10 backfills them
// and makes them required.
model User {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid())

  googleSub     String  @unique
  email         String
  emailVerified Boolean @default(false)
  name          String?
  imageUrl      String?

  status      String    @default("active") // active | disabled | deleted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  deletedAt   DateTime?

  gmailAccounts GmailAccount[]
  emails        Email[]
  events        Event[]
  eventUpdates  EventUpdate[]

  @@index([email])
}

model Event {
  id Int @id @default(autoincrement())

  // Nullable during the expand phase (RFC-001 §19 Phase 1). Nothing reads it
  // yet; recognition queries remain unscoped until AC-5.8.
  userId Int?

  company String
  stage   String
  date    DateTime
  time    String?
  venue   String?

  eventKey String @unique

  confidence   Float   @default(0)
  status       String  @default("scheduled")
  reviewReason String?

  isTimeEstimated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?         @relation(fields: [userId], references: [id])
  updates EventUpdate[]

  @@index([userId, date])
  @@index([userId, status])
}

model EventUpdate {
  id Int @id @default(autoincrement())

  userId Int?

  eventId  Int
  field    String
  oldValue String
  newValue String

  updatedAt DateTime @default(now())

  user  User?  @relation(fields: [userId], references: [id])
  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, eventId])
}

model Email {
  id             Int     @id @default(autoincrement())
  gmailMessageId String? @unique

  userId Int?

  // The Gmail account that synced this email. Optional so pre-existing rows
  // (synced before accounts were tracked) remain valid; every newly synced
  // email always stores its originating account.
  gmailAccountId Int?

  subject String
  body    String
  sender  String

  receivedAt DateTime @default(now())

  processingStatus String  @default("pending")
  failureReason    String?

  createdAt DateTime @default(now())

  user         User?             @relation(fields: [userId], references: [id])
  gmailAccount GmailAccount?     @relation(fields: [gmailAccountId], references: [id])
  extractions  EmailExtraction[]
  attachments  Attachment[]

  @@index([gmailAccountId])
  @@index([userId, receivedAt])
  @@index([userId, processingStatus])
}

model Attachment {
  id      Int @id @default(autoincrement())
  emailId Int

  // Tenant key, carried as a plain column with no relation to User. Enforcement
  // for derivative records runs through the parent: AC-5.10 attaches the
  // composite foreign key to Email(id, userId) (RFC-001 §7.2, §12.3), which is
  // what makes tenant divergence from the owning Email unrepresentable. A direct
  // User relation would add a second, weaker path to the same fact — which is
  // why RFC-001 §12.1 lists no back-relation for this model.
  userId Int?

  gmailAttachmentId String
  filename          String
  mimeType          String
  size              Int?

  storagePath String?

  // Full processing lifecycle (download + future parsing/extraction), not just
  // download: pending -> processing -> completed | failed.
  processingStatus String    @default("pending")
  processingError  String?
  processedAt      DateTime?

  // Parsed document results, populated by DocumentProcessingService when a
  // parser handles this attachment's MIME type. Independent of download status:
  // a parse failure records `parsingError` but leaves the attachment completed.
  text           String? // normalized extracted text
  parsedData     Json? // structured parser output (e.g. future Excel rows)
  parsedMetadata Json? // parser-specific metadata (e.g. PDF page count)
  parsedAt       DateTime? // successful parse time
  parsingError   String? // parse failure reason (download still succeeded)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailExtraction {
  id Int @id @default(autoincrement())

  emailId Int

  // See Attachment.userId — same pattern, same reason.
  userId Int?

  company String?
  stage   String?
  date    DateTime?
  time    String?
  venue   String?

  isTimeEstimated Boolean?
  status          String?

  confidence Float

  rawText String?

  createdAt DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

// The mailbox provider this connection represents (RFC-001 §12.2). A
// discriminator, not an abstraction: there is no strategy interface and no
// dispatch keyed on it. It exists so the provider is data rather than only the
// table's name — integration code can assert `provider == GOOGLE` instead of
// assuming it, and a second provider would not require renaming a table that
// carries foreign keys from Email, EmailExtraction and Attachment.
//
// `@default(GOOGLE)` exists so this expand migration needs no backfill; it
// should be dropped if a second variant is ever added, so new rows must state
// their provider explicitly.
enum MailProvider {
  GOOGLE
}

model GmailAccount {
  id     Int @id @default(autoincrement())
  userId Int?

  provider MailProvider @default(GOOGLE)

  email        String   @unique
  refreshToken String
  historyId    String?
  connectedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
}
