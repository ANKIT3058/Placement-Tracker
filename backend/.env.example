# ---------------------------------------------------------------------------
# Backend environment configuration — TEMPLATE.
#
#   cp .env.example .env
#
# `.env` is gitignored. This file is NOT. Never put a real credential here.
# Every value below is a placeholder or a local-development default.
# ---------------------------------------------------------------------------


# --- Required ---------------------------------------------------------------

# PostgreSQL connection string.
#
# Read by BOTH the Prisma CLI (via prisma.config.ts) and the application runtime
# (src/lib/prisma.ts). This is the single place the database is configured —
# there is no second setting to keep in sync.
#
# The value below matches the `postgres` service in docker-compose.yml, whose
# credentials are already declared in that file. Replace it for any environment
# that is not the local throwaway container.
DATABASE_URL=postgresql://placement_admin:password123@127.0.0.1:5435/placement?sslmode=disable&schema=public

# Redis connection string. Required by BullMQ and by both workers.
# NOT provided by docker-compose.yml — run Redis separately.
REDIS_URL=redis://localhost:6379

# Allowed CORS origin for the client (src/app.ts). Must match where the Vite dev
# server is actually served from.
FRONTEND_URL=http://localhost:5173


# --- Required for Gmail ingestion -------------------------------------------
# Obtain from the Google Cloud Console OAuth client.
# Leave blank to run without mailbox sync; the manual POST /email path still works.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match the Google Cloud Console entry byte for byte — scheme, host, port,
# path — and must route to GET /gmail/callback.
GOOGLE_REDIRECT_URI=http://localhost:3000/gmail/callback


# --- Sessions ---------------------------------------------------------------

# Signing key for the session cookie. REQUIRED in production — the process
# refuses to start without it, because a default signing key is a forgeable
# session cookie and the failure would otherwise be silent. Unset in
# development, a throwaway default is used and a warning is logged.
#
# Comma-separated values enable rotation: the first signs, all of them verify.
# Prepend a new key, wait out the session lifetime, then drop the old one.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Redis for the session store. Falls back to REDIS_URL when unset, which is fine
# locally — sessions live under `sess:` and BullMQ under `bull:`, so they cannot
# collide.
#
# Point this at a SEPARATE instance in production. The queue instance must run
# `maxmemory-policy noeviction` (an evicted job key is a lost job); a session
# store may not. Sessions expire by TTL, never by eviction.
SESSION_REDIS_URL=

# Cookie Domain attribute. Set ONLY when the API and the frontend are on
# different hosts under one registrable domain — e.g. `.example.com` for
# app.example.com + api.example.com. Leave unset for single-host deployments and
# local development; the cookie then gets the `__Host-` prefix in production,
# which binds it to the exact origin.
#
# The API and the frontend must share a registrable domain. Split across
# unrelated domains the session cookie becomes a third-party cookie, which
# browsers block or cap, and users are logged out non-deterministically.
SESSION_COOKIE_DOMAIN=


# --- Optional ---------------------------------------------------------------

# Set to "production" in deployed environments. Turns on Secure cookies, the
# `trust proxy` hop needed to send them behind a TLS-terminating proxy, and the
# hard failure on a missing SESSION_SECRET.
NODE_ENV=development

# "true" enables the OpenAI extraction path. Any other value, including unset,
# runs pattern extraction only. Compared against the literal string "true".
USE_AI=false

# Required only when USE_AI=true. getOpenAIClient() throws when it is unset.
OPENAI_API_KEY=

# HTTP port for the API. Defaults to 3000.
PORT=3000

# Gmail scheduler interval in milliseconds. Defaults to 120000 (2 minutes).
GMAIL_SYNC_INTERVAL_MS=120000

# Root directory for downloaded attachments.
# Defaults to <cwd>/storage/attachments, which is gitignored.
ATTACHMENT_STORAGE_DIR=
