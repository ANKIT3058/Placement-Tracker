# ---------------------------------------------------------------------------
# Backend environment configuration — TEMPLATE.
#
#   cp .env.example .env
#
# `.env` is gitignored. This file is NOT. Never put a real credential here.
# Every value below is a placeholder or a local-development default.
# ---------------------------------------------------------------------------


# --- Required ---------------------------------------------------------------

# PostgreSQL connection strings — POOLED and DIRECT.
#
# Two variables, because the runtime and the migration engine want opposite
# things from the same database:
#
#   DATABASE_URL         POOLED. Read by the application runtime
#                        (src/lib/prisma.ts), which passes it to the PrismaPg
#                        adapter. Many short-lived queries across concurrent
#                        handlers, so connection reuse is the point.
#
#   DIRECT_DATABASE_URL  DIRECT — no pooler. Read by prisma.config.ts, and used
#                        by `prisma migrate`, `prisma db` and `prisma studio`.
#                        Migrations take a SESSION-level advisory lock to
#                        serialise concurrent deploys, and a transaction pooler
#                        such as PgBouncer cannot hold one: the lock is taken on
#                        one backend and released to another. Running DDL through
#                        a transaction pooler is unsafe for the same reason.
#
# Note for Prisma 7: these do NOT appear in schema.prisma. Prisma 7 removed
# `url` and `directUrl` from the schema file, so the split is expressed by which
# side reads which variable — prisma.config.ts for Migrate, the client adapter
# for the runtime.
#
# On Neon the two differ only by the `-pooler` suffix on the host:
#   pooled  ...@ep-NAME-pooler.REGION.aws.neon.tech/DB?sslmode=require
#   direct  ...@ep-NAME.REGION.aws.neon.tech/DB?sslmode=require
#
# On a plain local Postgres there is no pooler, so set BOTH to the same value.
# The two values below match the `postgres` service in docker-compose.yml, whose
# credentials are already declared in that file. Replace them for any
# environment that is not the local throwaway container.
#
# Neither may be omitted: Prisma's env() throws rather than falling back, so an
# unset DIRECT_DATABASE_URL fails every migrate command immediately with
# `Cannot resolve environment variable: DIRECT_DATABASE_URL`.
DATABASE_URL=postgresql://placement_admin:password123@127.0.0.1:5435/placement?sslmode=disable&schema=public
DIRECT_DATABASE_URL=postgresql://placement_admin:password123@127.0.0.1:5435/placement?sslmode=disable&schema=public

# Redis connection string. Required by BullMQ and by both workers.
# NOT provided by docker-compose.yml — run Redis separately.
REDIS_URL=redis://localhost:6379

# Allowed CORS origin for the client (src/app.ts). Must match where the Vite dev
# server is actually served from.
FRONTEND_URL=http://localhost:5173


# --- Required for Gmail ingestion -------------------------------------------
# Obtain from the Google Cloud Console OAuth client.
# Leave blank to run without mailbox sync; the manual POST /email path still works.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match the Google Cloud Console entry byte for byte — scheme, host, port,
# path — and must route to GET /gmail/callback.
GOOGLE_REDIRECT_URI=http://localhost:3000/gmail/callback


# --- Sessions ---------------------------------------------------------------

# Signing key for the session cookie. REQUIRED in production — the process
# refuses to start without it, because a default signing key is a forgeable
# session cookie and the failure would otherwise be silent. Unset in
# development, a throwaway default is used and a warning is logged.
#
# Comma-separated values enable rotation: the first signs, all of them verify.
# Prepend a new key, wait out the session lifetime, then drop the old one.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Redis for the session store. Falls back to REDIS_URL when unset, which is fine
# locally — sessions live under `sess:` and BullMQ under `bull:`, so they cannot
# collide.
#
# Point this at a SEPARATE instance in production. The queue instance must run
# `maxmemory-policy noeviction` (an evicted job key is a lost job); a session
# store may not. Sessions expire by TTL, never by eviction.
SESSION_REDIS_URL=

# Cookie Domain attribute. Set ONLY when the API and the frontend are on
# different hosts under one registrable domain — e.g. `.example.com` for
# app.example.com + api.example.com. Leave unset for single-host deployments and
# local development; the cookie then gets the `__Host-` prefix in production,
# which binds it to the exact origin.
#
# The API and the frontend must share a registrable domain. Split across
# unrelated domains the session cookie becomes a third-party cookie, which
# browsers block or cap, and users are logged out non-deterministically.
SESSION_COOKIE_DOMAIN=


# --- Optional ---------------------------------------------------------------

# Set to "production" in deployed environments. Turns on Secure cookies, the
# `trust proxy` hop needed to send them behind a TLS-terminating proxy, and the
# hard failure on a missing SESSION_SECRET.
NODE_ENV=development

# "true" enables the OpenAI extraction path. Any other value, including unset,
# runs pattern extraction only. Compared against the literal string "true".
USE_AI=false

# Required only when USE_AI=true. getOpenAIClient() throws when it is unset.
OPENAI_API_KEY=

# HTTP port for the API. Defaults to 3000.
PORT=3000

# Gmail scheduler interval in milliseconds. Defaults to 120000 (2 minutes).
GMAIL_SYNC_INTERVAL_MS=120000

# Deadline for a SINGLE outbound Gmail or Google OAuth HTTP request, in
# milliseconds. Defaults to 10000 (10 seconds).
#
# Set once on the OAuth client, so it bounds the token refresh, every Gmail API
# call, every page of a paginated walk, and attachment downloads. Per attempt,
# not per operation: gaxios re-arms it on each retry.
#
# Invalid values fall back to the default rather than being clamped — including
# 0, which reads as "no timeout" and is the exact condition this bounds.
GMAIL_REQUEST_TIMEOUT_MS=10000

# Root directory for downloaded attachments.
# Defaults to <cwd>/storage/attachments, which is gitignored.
ATTACHMENT_STORAGE_DIR=

# How often the email reconciler sweeps for Emails that were persisted but never
# handed to the queue, in milliseconds. Defaults to 60000 (1 minute).
#
# Runs in the API process (npm run dev / npm start), on its own timer — not in a
# worker. Invalid values fall back to the default.
EMAIL_RECONCILE_INTERVAL_MS=60000

# How long an Email may sit "pending" before the reconciler treats it as never
# queued, in milliseconds. Defaults to 300000 (5 minutes).
#
# A row stays pending until a worker picks it up, so a legitimately queued email
# is indistinguishable from an orphan until this much time has passed — the
# cutoff has to clear a normal queue backlog or the sweep chases work already in
# flight. Lower it in development to watch recovery happen. Invalid values fall
# back to the default.
EMAIL_RECONCILE_MIN_AGE_MS=300000

# EMAIL WORKER ONLY, and read once at worker startup.
#
# "true" makes the email worker exit after the queue is genuinely drained
# (waiting, active, delayed, paused, prioritized and waiting-children all zero)
# instead of running permanently. Any other value, including unset, leaves it a
# permanent worker. Compared against the literal string "true".
#
# Leave unset for local development — `npm run worker:email` should stay up. It
# is set only by the production drain workflow, which runs the worker as a
# one-shot batch rather than a long-lived process.
WORKER_EXIT_WHEN_DRAINED=
