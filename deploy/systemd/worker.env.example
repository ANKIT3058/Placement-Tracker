# Placement Tracker — worker environment, TEMPLATE.
#
#   sudo install -d -m 0750 -o root -g placement /etc/placement-tracker
#   sudo cp worker.env.example /etc/placement-tracker/worker.env
#   sudo chown root:placement /etc/placement-tracker/worker.env
#   sudo chmod 0640           /etc/placement-tracker/worker.env
#
# This file is NOT a secret and is committed. The one at /etc/placement-tracker
# IS, and must never be committed. Every value below is a placeholder.
#
# ---------------------------------------------------------------------------
# THIS IS NOT A .env FILE. systemd's EnvironmentFile parser is not dotenv:
#
#   * no `export` prefix
#   * no variable expansion — a literal `$` must be written `$$`
#   * no inline comments; `#` starts a comment only at the beginning of a line
#   * do not quote values unless they contain spaces
#
# A Postgres password containing `$` is the one that catches people. Percent-
# encode it in the URL, or double every `$`.
# ---------------------------------------------------------------------------


# --- Required by BOTH workers -----------------------------------------------

# POOLED connection string, the same value the Render web service uses.
# DIRECT_DATABASE_URL is deliberately absent: it is read only by the Prisma CLI
# for migrations, which are applied from a workstation and never from the VM.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# The queue Redis — the SAME instance the Render web service enqueues to, or the
# workers consume an empty queue. Must run with `maxmemory-policy noeviction`;
# an evicted job key is a lost job.
#
# SESSION_REDIS_URL is deliberately absent. Sessions belong to the web service;
# no worker touches them.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT


# --- Required by the ATTACHMENT worker only ---------------------------------
#
# It downloads each file from Gmail before parsing it, and exchanges the stored
# refresh token for an access token to do so. Absent, every job fails at the
# token refresh with `400 invalid_request` — the failure that motivated the
# startup check in src/shared/config/worker-env.ts.
#
# Harmless to the email worker, which never calls Gmail. GOOGLE_REDIRECT_URI is
# NOT needed: it matters only to the interactive OAuth consent flow, which lives
# in the web service.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret


# --- Optional ---------------------------------------------------------------

NODE_ENV=production

# "true" enables the OpenAI-assisted branch of extraction. Any other value,
# including unset, runs deterministic pattern extraction only.
#
# When this is exactly "true", BOTH workers additionally require
# OPENAI_API_KEY and refuse to start without it. That is on purpose: the AI call
# sites are fail-soft, so a missing key would not fail a single job — it would
# silently degrade every one of them.
USE_AI=false

# Required only when USE_AI=true.
OPENAI_API_KEY=

# DO NOT SET. "true" makes a worker exit as soon as its queue is empty, which
# under systemd means an immediate restart, forever. Both units pin it empty
# after loading this file, so a stray value here is overridden rather than
# obeyed — but leave it out regardless.
#
# It belongs to the GitHub Actions drain workflows, which are one-shot by design.
# WORKER_EXIT_WHEN_DRAINED=

# Set by the attachment unit itself, to a path inside its StateDirectory.
# Overriding it here would point downloads at a directory ProtectSystem=strict
# makes read-only.
# ATTACHMENT_STORAGE_DIR=
